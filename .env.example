# ==============================================================================
# Job Tracker Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# WARNING: NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=jobtracker
POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=replace_with_secure_database_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobtracker
SPRING_DATASOURCE_USERNAME=tracker_user
SPRING_DATASOURCE_PASSWORD=replace_with_secure_database_password

# ------------------------------------------------------------------------------
# JWT Authentication & Session Settings
# ------------------------------------------------------------------------------
# Must be at least 256 bits (32 bytes / characters) long for HS256 algorithm
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
# Expiration time in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Google Cloud OAuth 2.0 (Gmail API Integration)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Authorized Redirect URI must include: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent

# ------------------------------------------------------------------------------
# AES-256 Token Encryption Secret
# ------------------------------------------------------------------------------
# Used to encrypt Google OAuth refresh tokens at rest in PostgreSQL.
# MUST be exactly 16, 24, or 32 bytes (characters) long for AES encryption.
ENCRYPTION_SECRET=16CharSecretKey!
